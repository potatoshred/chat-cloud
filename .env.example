# Copy to .env, set your own login password and DeepSeek API key, then run Compose.
AUTH_USERNAME=admin
# Required: 14–256 characters. Single quotes preserve literal $ and # in Compose .env files.
AUTH_PASSWORD=
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# Optional: uncomment when enabling the cloudflared service in compose.yaml.
# CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token

# Cloudflare 免费版（cloudflare/）：Workers + D1，不要填 Docker 用的变量。
# 部署按钮会读取本文件来提示需要填写的变量。
# AUTH_USERNAME=admin
# AUTH_PASSWORD=
# DEEPSEEK_API_KEY=
